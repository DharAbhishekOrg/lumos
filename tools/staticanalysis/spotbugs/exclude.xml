<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lumos - tools/staticanalysis / SpotBugs exclusion filter for TRS-CODE-006.
  Author: dhar.abhishek.email@gmail.com
  Implements: TRS-CODE-006
  ADRs: ADR-004
  Threading: n/a
  Notes: One exclusion, and it is a scope decision rather than a suppressed
  finding. `com.lumos.protocol` is the generated register - LumosConstants,
  LumosErrors, MessageClass, MessageClassLimits and TextEventKind, all emitted by
  tools/constantsgen from protocol/constants/lumos_constants.json. A SpotBugs
  finding there is not something a person can fix in place: the file is
  overwritten on every generation, and the constants gate byte-compares it
  against the generator's output, so an edit would fail CI rather than land.
  If the generator ever emits a genuine defect, the fix belongs in the emitter.

  The exclusion names the package EXACTLY, so `com.lumos.protocol.conformance` -
  the hand-written Frame and LumosCrypto codecs this module exists to check - is
  fully analysed, as is anything else added under a sub-package later.

  The second exclusion is narrower still: `throws Exception` on a JUnit test
  method. It is the framework's own idiom - JUnit invokes tests reflectively and
  treats any throwable as a failure - so narrowing the clause would list the
  checked exceptions of whatever the test happens to call today and have to be
  rewritten whenever that changes. It is scoped to test classes and to that one
  pattern; every other SpotBugs rule still applies to test code.
-->
<FindBugsFilter>
  <Match>
    <Package name="com.lumos.protocol"/>
  </Match>
  <Match>
    <Class name="~.*Test$"/>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>

  <!--
    Room's generated implementations. Same reasoning as the generated register
    above: `_Impl` classes are written by the Room annotation processor on every
    build, a finding in one names a defect nobody can fix in place, and an edit
    would simply be overwritten. If Room ever generates a genuine defect, the
    fix is a Room version bump or a change to the entity that produced it.

    The pattern matches the processor's own suffix and the anonymous inner
    classes it emits inside them (ProfileDao_Impl$1 and friends), so
    hand-written classes in the same package - RoomSqlDatabase,
    LumosRoomDatabase, ProfileDao - are fully analysed.
  -->
  <Match>
    <Class name="~.*_Impl(\$.*)?$"/>
  </Match>

  <!--
    Constructor-injected collaborators, one class at a time.

    EI_EXPOSE_REP2 fires whenever a constructor stores a reference to a mutable
    object, which is exactly what TRS Sec. 24.2's mandated constructor injection
    does with every collaborator. It is NOT blanket-excluded, because the same
    pattern also catches a genuine defect - a constructor retaining a caller's
    array - and SpotBugs caught precisely that in the Java Frame during WP-02
    S1. So each collaborator is listed explicitly and a new one has to be
    thought about rather than absorbed.
  -->
  <Match>
    <Class name="com.lumos.app.profile.ProfileRepository"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!--
    WP-02 slice S4c's collaborators, added one class at a time for the reason
    stated above. Each of these constructors stores a LocalStore, a KekStore, an
    IdentityRepository or a Clock - all of them long-lived services the caller is
    meant to keep using, not buffers whose contents could be rewritten behind the
    holder's back. Copying any of them would be meaningless; sharing them is the
    point of injecting them.

    Note what is NOT here: nothing in this slice that takes a byte[] is excluded.
    RecoveryBundle.Item, IdentityKeyRecord, RestoreResult and ResetResult all
    clone their arrays in and out, and SpotBugs is left free to say so if one
    ever stops.
  -->
  <Match>
    <Class name="com.lumos.app.onboarding.ConsentRepository"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.onboarding.DiscoveryVisibility"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    WP-03 slice S5b: AppLock stores the injected LocalStore and the DeviceAuth
    seam - the same long-lived-service rationale as the block above, and the
    DeviceAuth interface is precisely the thing that must be shared, because a
    copied prompt would be a prompt the tests could not script.
  -->
  <Match>
    <Class name="com.lumos.app.safety.AppLock"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    WP-03 slice S6: the discovery-success metric stores the injected
    LocalStore, the same long-lived-service rationale as every entry above.
  -->
  <Match>
    <Class name="com.lumos.app.ble.DiscoverySuccessMetric"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    WP-04 slice S1a: the two peer-list classes store the injected LocalStore,
    the same long-lived-service rationale as every entry above.
  -->
  <Match>
    <Class name="com.lumos.app.nearby.HiddenPeers"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.nearby.BlockedPeers"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    WP-04 S1c: NearbyActivity is an Android Activity, which the OS constructs
    and then initialises through onCreate - fields set there are "not
    initialised in the constructor" by design of the platform, and
    findViewById's generic return makes every typed lookup an "unconfirmed
    cast". Both detectors assume plain-Java construction; neither assumption
    holds for a lifecycle class. Scoped to this one class, not the package.
  -->
  <Match>
    <Class name="com.lumos.app.nearby.NearbyActivity"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.nearby.NearbyActivity"/>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
  </Match>
  <!--
    WP-04 S3b: the interest ledger and its budget store the injected
    LocalStore, the same long-lived-service rationale as every entry above.
  -->
  <Match>
    <Class name="com.lumos.app.match.InterestLedger"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.match.PersistedBudget"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.onboarding.OnboardingService"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.identity.IdentityRepository"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.identity.IdentityReset"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.recovery.RecoverySetup"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.recovery.RecoveryRestore"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.wipe.EmergencyWipe"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    WP-03 S2b's collaborators, same discipline: one class at a time. The BLE
    adapters store the device's BluetoothAdapter - the platform handle sharing
    is the adapter's entire job - and FrameLink stores the operation queue,
    the reassembler and the blob consumer it was built to wire together. The
    byte[] paths in the same package are NOT excluded: ScanSighting and
    Adv.Payload clone their arrays in and out, and SpotBugs stays free to say
    so if one ever stops.
  -->
  <Match>
    <Class name="com.lumos.app.ble.AndroidBleScanner"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.ble.AndroidBleAdvertiser"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.ble.FrameLink"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    IdentityCrypto.KeyMaterial adopts and returns its live arrays ON PURPOSE,
    and the EI_EXPOSE heuristic cannot see why: the private half is key
    material whose only safe end state is being ZEROED IN PLACE via destroy().
    A defensive copy at the constructor or accessor would hand every caller an
    unzeroable duplicate of a private key - the heap-hygiene hole the live
    array prevents - so here the "defensive" idiom is the defect and the
    exposure is the feature. The class documents the adopt-and-zero contract,
    its callers (IdentityKeyGenerator) zero in finally blocks, and the scope
    is exactly this one nested class: every other EI_EXPOSE finding anywhere
    else stays loud.
  -->
  <Match>
    <Class name="com.lumos.app.identity.IdentityCrypto$KeyMaterial"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!--
    WP-05 S7e2b: ChatRuntime is the chat composition root, and chat() hands
    out its one ChatStore ON PURPOSE - the UI reads conversations and marks
    them read through the same store the relay pass writes, so a copy would
    be a second, diverging store. Scoped to that one accessor; the runtime's
    other getters return services SpotBugs already treats as immutable.
  -->
  <Match>
    <Class name="com.lumos.app.relay.ChatRuntime"/>
    <Method name="chat"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!--
    CS2a: ConversationActivity is a lifecycle class exactly as NearbyActivity
    is (see above): findViewById's generic return and getApplication() make
    typed lookups "unconfirmed casts" (the application is checked with
    instanceof before the cast). setSource is the instrumented demo's seam,
    as NearbyActivity.setHost is: it stores the scripted source on purpose.
  -->
  <Match>
    <Class name="com.lumos.app.conversation.ConversationActivity"/>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
  </Match>
  <!-- The adapter binds its rows' views with the same generic findViewById. -->
  <Match>
    <Class name="com.lumos.app.conversation.MessageAdapter"/>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.conversation.ConversationActivity"/>
    <Method name="setSource"/>
    <Bug pattern="EI_EXPOSE_STATIC_REP2"/>
  </Match>
  <!--
    CS2a: constructor-injected collaborators (TRS Sec. 24.2), one class at a
    time as the policy above asks: the presenter keeps its chat source (it
    copies the match id), and the runtime source keeps the Application, whose
    lifetime is the process. The presenter's Screen copies its rows with
    List.copyOf, which SpotBugs cannot see is unmodifiable.
  -->
  <Match>
    <Class name="com.lumos.app.conversation.ConversationPresenter"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.conversation.RuntimeConversationSource"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.conversation.ConversationPresenter$Screen"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!--
    CS2c: constructor-injected collaborators again, one class at a time. The
    home shell's runtime source keeps the Application (its lifetime is the
    process), and NearbyPanel keeps the panel's root view and the Nearby host
    it renders, exactly as NearbyActivity kept them before the panel was
    extracted from it.
  -->
  <!--
    CS2c: HomeActivity is a lifecycle class like ConversationActivity: the
    generic findViewById return reads as an unconfirmed cast.
  -->
  <Match>
    <Class name="com.lumos.app.home.HomeActivity"/>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.home.RuntimeHomeSource"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.nearby.NearbyPanel"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    CS2d: OnboardingActivity is a lifecycle class like NearbyActivity: fields
    are set in onCreate, and findViewById's and getApplication()'s generic
    returns read as unconfirmed casts. LumosApplication.host() hands out the
    process's one AppHost on purpose: it is the composition root's shared
    host, as NearbyActivity.setHost already stores it.
  -->
  <Match>
    <Class name="com.lumos.app.onboarding.OnboardingActivity"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.onboarding.OnboardingActivity"/>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.LumosApplication"/>
    <Method name="host"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!--
    NB-1 step 1: NearbyHost gained default methods (Visible Nearby), which
    makes SpotBugs read it as a mutable type. The host is the composition
    root's shared, long-lived object by design: NearbyActivity's static seam
    stores and returns it (the state demo and HomeActivity use the same one),
    the card adapter keeps the host it renders for, AppHost hands out its one
    Visible Nearby controller, and the controller keeps its injected
    collaborators - the constructor-injection rationale used throughout.
  -->
  <Match>
    <Class name="com.lumos.app.nearby.NearbyActivity"/>
    <Or>
      <Method name="setHost"/>
      <Method name="host"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_STATIC_REP2"/>
      <Bug pattern="MS_EXPOSE_REP"/>
    </Or>
  </Match>
  <Match>
    <Class name="com.lumos.app.nearby.NearbyCardAdapter"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.AppHost"/>
    <Method name="visibleNearby"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.nearby.VisibleNearbyController"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    CS6 chat settings. ChatSettings stores the injected LocalStore (the
    long-lived-service rationale of the S4c block). ChatRuntime.settings()
    hands out the runtime's one ChatSettings on purpose, like chat(): the
    switch and markRead must read the same choice. Holding it makes the
    runtime itself read as mutable, so LumosApplication.runtime() - the
    composition root handing out its one runtime, like host() - is listed too.
  -->
  <Match>
    <Class name="com.lumos.app.chat.ChatSettings"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.relay.ChatRuntime"/>
    <Method name="settings"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.LumosApplication"/>
    <Method name="runtime"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!--
    CS6 read-receipt switch: HomeSource gained default methods, which makes
    SpotBugs read it as a mutable type (the NB-1 NearbyHost case). setSource
    is the instrumented test's static seam and stores the scripted source on
    purpose, exactly as NearbyActivity.setHost stores its host.
  -->
  <Match>
    <Class name="com.lumos.app.home.HomeActivity"/>
    <Method name="setSource"/>
    <Bug pattern="EI_EXPOSE_STATIC_REP2"/>
  </Match>
  <!--
    NB-1 step 3b: AndroidGattLink.bind stores the one DiscoveryEngine the
    links report to - the engine is the radio's owner and shared on purpose;
    a copy would be an engine nobody else drives.
  -->
  <Match>
    <Class name="com.lumos.app.ble.AndroidGattLink"/>
    <Method name="bind"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    NB-1 step 3c: PresenceTable gained clear(), so SpotBugs now reads it as
    mutable. DiscoveryEngine and NearbyFeedController take the one presence
    table they share with their caller on purpose (the engine's "already
    found" table; the feed's table, written on the store's executor), and
    NearbyDiscovery holds the app's one open store, like every other
    store-backed service (the S4c rationale).
  -->
  <Match>
    <Or>
      <Class name="com.lumos.app.ble.DiscoveryEngine"/>
      <Class name="com.lumos.app.nearby.NearbyFeedController"/>
      <Class name="com.lumos.app.nearby.NearbyDiscovery"/>
    </Or>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
