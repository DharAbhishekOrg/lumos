<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lumos - tools/staticanalysis / SpotBugs exclusion filter for TRS-CODE-006.
  Author: dhar.abhishek.email@gmail.com
  Implements: TRS-CODE-006
  ADRs: ADR-004
  Threading: n/a
  Notes: One exclusion, and it is a scope decision rather than a suppressed
  finding. `com.lumos.protocol` is the generated register - LumosConstants,
  LumosErrors, MessageClass, MessageClassLimits and TextEventKind, all emitted by
  tools/constantsgen from protocol/constants/lumos_constants.json. A SpotBugs
  finding there is not something a person can fix in place: the file is
  overwritten on every generation, and the constants gate byte-compares it
  against the generator's output, so an edit would fail CI rather than land.
  If the generator ever emits a genuine defect, the fix belongs in the emitter.

  The exclusion names the package EXACTLY, so `com.lumos.protocol.conformance` -
  the hand-written Frame and LumosCrypto codecs this module exists to check - is
  fully analysed, as is anything else added under a sub-package later.

  The second exclusion is narrower still: `throws Exception` on a JUnit test
  method. It is the framework's own idiom - JUnit invokes tests reflectively and
  treats any throwable as a failure - so narrowing the clause would list the
  checked exceptions of whatever the test happens to call today and have to be
  rewritten whenever that changes. It is scoped to test classes and to that one
  pattern; every other SpotBugs rule still applies to test code.
-->
<FindBugsFilter>
  <Match>
    <Package name="com.lumos.protocol"/>
  </Match>
  <Match>
    <Class name="~.*Test$"/>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>

  <!--
    Room's generated implementations. Same reasoning as the generated register
    above: `_Impl` classes are written by the Room annotation processor on every
    build, a finding in one names a defect nobody can fix in place, and an edit
    would simply be overwritten. If Room ever generates a genuine defect, the
    fix is a Room version bump or a change to the entity that produced it.

    The pattern matches the processor's own suffix and the anonymous inner
    classes it emits inside them (ProfileDao_Impl$1 and friends), so
    hand-written classes in the same package - RoomSqlDatabase,
    LumosRoomDatabase, ProfileDao - are fully analysed.
  -->
  <Match>
    <Class name="~.*_Impl(\$.*)?$"/>
  </Match>

  <!--
    Constructor-injected collaborators, one class at a time.

    EI_EXPOSE_REP2 fires whenever a constructor stores a reference to a mutable
    object, which is exactly what TRS Sec. 24.2's mandated constructor injection
    does with every collaborator. It is NOT blanket-excluded, because the same
    pattern also catches a genuine defect - a constructor retaining a caller's
    array - and SpotBugs caught precisely that in the Java Frame during WP-02
    S1. So each collaborator is listed explicitly and a new one has to be
    thought about rather than absorbed.
  -->
  <Match>
    <Class name="com.lumos.app.profile.ProfileRepository"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!--
    WP-02 slice S4c's collaborators, added one class at a time for the reason
    stated above. Each of these constructors stores a LocalStore, a KekStore, an
    IdentityRepository or a Clock - all of them long-lived services the caller is
    meant to keep using, not buffers whose contents could be rewritten behind the
    holder's back. Copying any of them would be meaningless; sharing them is the
    point of injecting them.

    Note what is NOT here: nothing in this slice that takes a byte[] is excluded.
    RecoveryBundle.Item, IdentityKeyRecord, RestoreResult and ResetResult all
    clone their arrays in and out, and SpotBugs is left free to say so if one
    ever stops.
  -->
  <Match>
    <Class name="com.lumos.app.onboarding.ConsentRepository"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.onboarding.DiscoveryVisibility"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.onboarding.OnboardingService"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.identity.IdentityRepository"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.identity.IdentityReset"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.recovery.RecoverySetup"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.recovery.RecoveryRestore"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.lumos.app.wipe.EmergencyWipe"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    IdentityCrypto.KeyMaterial adopts and returns its live arrays ON PURPOSE,
    and the EI_EXPOSE heuristic cannot see why: the private half is key
    material whose only safe end state is being ZEROED IN PLACE via destroy().
    A defensive copy at the constructor or accessor would hand every caller an
    unzeroable duplicate of a private key - the heap-hygiene hole the live
    array prevents - so here the "defensive" idiom is the defect and the
    exposure is the feature. The class documents the adopt-and-zero contract,
    its callers (IdentityKeyGenerator) zero in finally blocks, and the scope
    is exactly this one nested class: every other EI_EXPOSE finding anywhere
    else stays loud.
  -->
  <Match>
    <Class name="com.lumos.app.identity.IdentityCrypto$KeyMaterial"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
