<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos - android-app/app / Delivery-tick colours.
  Author: dhar.abhishek.email@gmail.com
  Implements: SRS-RMT-005
  ADRs: -
  Threading: n/a
  Notes: The owner's WhatsApp-style ruling (2026-11-21): grey for pending,
  sent and delivered, blue for read, red for failed. The nearby colour marks
  content that waits for a Bluetooth/Wi-Fi path. Since CR-008 each is the
  design token for its meaning, so it follows Midnight and Daylight and the
  token gate holds it readable on every bubble.
-->
<resources>
    <color name="tick_pending">@color/lumos_tick</color>
    <color name="tick_sent">@color/lumos_tick</color>
    <color name="tick_read">@color/lumos_read</color>
    <color name="tick_failed">@color/lumos_danger</color>
    <color name="tick_nearby">@color/lumos_aqua</color>
</resources>
