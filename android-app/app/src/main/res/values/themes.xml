<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos - android-app/app / The Material 3 application theme, on the CR-008 tokens.
  Author: dhar.abhishek.email@gmail.com
  Implements: TRS-AND-003, TRS-UX-001, TRS-UX-002, SRS-UX-003, SRS-NFR-A11Y-002
  ADRs: -
  Threading: n/a
  Notes: Material 3's colour roles mapped onto the design tokens, which
  tools/tokensgen writes into values/ (Daylight) and values-night/ (Midnight),
  so DayNight picks the right set and the app picks Midnight by default
  (LumosApplication). Every on-colour below is a pair the token gate holds to
  WCAG AA. Shapes take the token radii. Display text takes Sora (SIL OFL 1.1,
  owner-approved 2026-11-23, unmodified) from API 28 (values-v28), and
  everything else stays the platform face so font scaling behaves natively.
  NoActionBar because each screen owns its own top area.
-->
<resources>
    <style name="Theme.Lumos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lumos_violet</item>
        <item name="colorOnPrimary">@color/lumos_on_violet</item>
        <item name="colorPrimaryContainer">@color/lumos_violet_soft</item>
        <item name="colorOnPrimaryContainer">@color/lumos_ink</item>
        <item name="colorSecondary">@color/lumos_aqua</item>
        <item name="colorOnSecondary">@color/lumos_canvas</item>
        <item name="colorTertiary">@color/lumos_coral</item>
        <item name="colorOnTertiary">@color/lumos_canvas</item>
        <item name="colorError">@color/lumos_danger</item>
        <item name="colorOnError">@color/lumos_canvas</item>
        <item name="android:colorBackground">@color/lumos_canvas</item>
        <item name="colorOnBackground">@color/lumos_ink</item>
        <item name="colorSurface">@color/lumos_surface</item>
        <item name="colorOnSurface">@color/lumos_ink</item>
        <item name="colorOnSurfaceVariant">@color/lumos_ink_muted</item>
        <item name="colorSurfaceContainerLow">@color/lumos_surface</item>
        <item name="colorSurfaceContainer">@color/lumos_surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/lumos_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/lumos_surface_high</item>
        <item name="colorOutline">@color/lumos_outline</item>
        <item name="colorOutlineVariant">@color/lumos_divider</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Lumos.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Lumos.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Lumos.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Lumos.ExtraLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Lumos.Display</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Lumos.Title1</item>
    </style>

    <!-- A conversation sits on surface, not canvas: the window paints it once. -->
    <style name="Theme.Lumos.Conversation">
        <item name="android:windowBackground">@color/lumos_surface</item>
    </style>

    <style name="ShapeAppearance.Lumos.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/lumos_radius_sm</item>
    </style>
    <style name="ShapeAppearance.Lumos.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/lumos_radius_md</item>
    </style>
    <style name="ShapeAppearance.Lumos.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/lumos_radius_lg</item>
    </style>
    <style name="ShapeAppearance.Lumos.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/lumos_radius_xl</item>
    </style>

    <!--
      Screen titles at the token size. On API 26-27 the platform face in bold:
      choosing a weight of a variable font from XML needs API 28, and Sora's
      default instance is regular, which would turn titles thin. values-v28
      replaces both styles with Sora at the token weights.
    -->
    <style name="TextAppearance.Lumos.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/lumos_type_display_size</item>
        <item name="lineHeight">@dimen/lumos_type_display_line_height</item>
        <item name="android:letterSpacing">-0.012</item>
    </style>

    <!-- Moments: the match, onboarding steps, empty states. -->
    <style name="TextAppearance.Lumos.Title1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/lumos_type_title_1_size</item>
        <item name="lineHeight">@dimen/lumos_type_title_1_line_height</item>
        <item name="android:letterSpacing">-0.007</item>
    </style>
</resources>
