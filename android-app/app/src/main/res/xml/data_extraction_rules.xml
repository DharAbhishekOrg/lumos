<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos - android-app/app / Backup and device-transfer exclusions (Android 12+).
  Author: dhar.abhishek.email@gmail.com
  Implements: SRS-DAT-012, TRS-LOC-001
  ADRs: ADR-003
  Threading: n/a
  Notes: ADR-003 is categorical - identity keys are hardware-backed,
  non-exportable and never escrowed, and backups exclude ALL cryptographic
  state. The safest expression of that is to exclude everything and add back
  only what a later work package can justify, rather than to enumerate
  exclusions and risk missing one. android:allowBackup is already false; these
  rules make the intent explicit and survive it being turned on by mistake.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
