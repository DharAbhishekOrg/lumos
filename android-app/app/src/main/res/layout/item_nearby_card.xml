<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos - android-app/app / One nearby card.
  Author: dhar.abhishek.email@gmail.com
  Implements: SRS-NBY-008, SRS-NBY-012
  ADRs: ADR-002
  Threading: main
  Notes: A person, in words a person would use (SRS-NBY-008): no identifier,
  no signal number, no distance. The hide action is right on the card because
  SRS-NBY-012 is a one-tap, one-sided act - no dialog, no explanation sent
  anywhere.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_card_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/card_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_card_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <Button
            android:id="@+id/card_hide"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_card_hide" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
