<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos - android-app/app / One profile field: what it says, and who can see it.
  Author: dhar.abhishek.email@gmail.com
  Implements: SRS-PRO-001, SRS-PRO-003, SRS-NFR-A11Y-001
  ADRs: -
  Threading: n/a
  Notes: Two 48dp targets: the field itself (edit) and its "Who can see
  this" line (change the audience), each with its own spoken label.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/lumos_space_2"
    android:paddingBottom="@dimen/lumos_space_2">

    <LinearLayout
        android:id="@+id/profile_field_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profile_field_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/lumos_ink" />

        <TextView
            android:id="@+id/profile_field_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/lumos_ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/profile_field_audience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/lumos_ink_muted" />
</LinearLayout>
