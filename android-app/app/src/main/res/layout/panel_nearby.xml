<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos - android-app/app / The Nearby panel: NearbyActivity's whole screen and the home shell's Nearby tab.
  Author: dhar.abhishek.email@gmail.com
  Implements: SRS-NBY-003, SRS-NBY-010, SRS-NBY-014, SRS-NBY-017
  ADRs: ADR-002
  Threading: main
  Notes: Three regions. The top strip is permanent: the SRS-NBY-003
  visibility indicator (shown only while advertising is actually active) and
  the SRS-NBY-017 one-action stop. Below it exactly one of two things is
  visible: the state message (the SRS-NBY-010 matrix and the SRS-NBY-014
  empty state - a sentence, never a spinner) or the card list. Which one, and
  with what text, is NearbyFeedController's decision rendered verbatim.
  NearbyPanel binds it, so both hosts render it the same way (CS2c).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nearby_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/visibility_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/visible_nearby_indicator_on"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:visibility="gone" />

        <Button
            android:id="@+id/stop_nearby"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_stop_everything" />
    </LinearLayout>

    <!-- Visible Nearby (SRS-NBY-001/002/003, NB-1 step 1): the choice of a
         while, the end time while visible, and why the radio is silent when
         it is. Hidden when the host has no Visible Nearby (the state demo). -->
    <LinearLayout
        android:id="@+id/visible_nearby_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/vn_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/visible_nearby_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/vn_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/vn_problem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vn_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/visible_nearby_duration_default" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vn_custom"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/visible_nearby_duration_custom" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vn_off"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/visibility_turn_off" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/visibility_never_automatic"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <TextView
        android:id="@+id/state_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nearby_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp"
        android:visibility="gone" />
</LinearLayout>
