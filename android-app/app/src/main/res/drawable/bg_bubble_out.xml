<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos - android-app/app / My message bubble, last of a run (tail at bottom right).
  Author: dhar.abhishek.email@gmail.com
  Implements: SRS-UX-011, TRS-UX-004, TRS-UX-002
  ADRs: -
  Threading: n/a
  Notes: Token colour and radii (CR-008): radius-lg, with a tighter corner where a run's tail points at its sender.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/lumos_bubble_out" />
    <corners
        android:topLeftRadius="@dimen/lumos_radius_lg"
        android:topRightRadius="@dimen/lumos_radius_lg"
        android:bottomRightRadius="6dp"
        android:bottomLeftRadius="@dimen/lumos_radius_lg" />
</shape>
