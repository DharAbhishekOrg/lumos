{
  "name": "lumos-admin-console",
  "version": "0.0.0",
  "private": true,
  "description": "Lumos owner and constrained-partner portal. WP-01 delivers an empty shell only.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "tsc",
    "pretest": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\"",
    "test": "tsc && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml dist/shell.test.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "typescript": "5.6.3",
    "typescript-eslint": "8.73.0"
  }
}
